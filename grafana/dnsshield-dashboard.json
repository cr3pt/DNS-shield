{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping DNS-shield's GET /metrics",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "DNS-shield",
  "description": "Query volume, blocking, cache and DNSSEC metrics exposed by DNS-shield's GET /metrics",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["dns-shield", "dns"],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "targets": [{ "expr": "dnsshield_uptime_seconds", "legendFormat": "uptime" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queries / min",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqpm", "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [{ "expr": "sum(rate(dnsshield_queries_total[5m])) * 60", "legendFormat": "queries/min" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Blocked ratio",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.3 }, { "color": "red", "value": 0.6 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(dnsshield_blocked_total[15m])) / sum(rate(dnsshield_queries_total[15m]))",
          "legendFormat": "blocked ratio"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Blocklist domains",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "targets": [{ "expr": "dnsshield_blocklist_domains", "legendFormat": "blocklist" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Unacknowledged alerts",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "targets": [{ "expr": "dnsshield_anomalies_unacknowledged", "legendFormat": "alerts" }]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Query volume",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Queries vs blocked (per second)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(dnsshield_queries_total[5m]))", "legendFormat": "total" },
        { "expr": "sum(rate(dnsshield_blocked_total[5m]))", "legendFormat": "blocked" }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "DNS answer cache",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Cache entries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "targets": [{ "expr": "dnsshield_cache_entries", "legendFormat": "entries" }]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Stale-served (upstream outages)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 4, "y": 15 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [{ "expr": "increase(dnsshield_cache_stale_hits_total[1h])", "legendFormat": "stale hits (1h)" }]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 14, "x": 10, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 15, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(dnsshield_cache_hits_total[5m])) / (sum(rate(dnsshield_cache_hits_total[5m])) + sum(rate(dnsshield_cache_misses_total[5m])))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "DNSSEC",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "DNSSEC status cache (secure vs insecure)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 15, "lineWidth": 2, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "dnsshield_dnssec_secure_cached", "legendFormat": "secure" },
        { "expr": "dnsshield_dnssec_insecure_cached", "legendFormat": "insecure" }
      ]
    }
  ]
}
